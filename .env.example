# FlowDay environment variables.
# Copy this file to `.env` (local dev) or set the same variables in the
# Vercel project settings. Never commit real secrets.

# Public Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Public Supabase anon key (safe for the browser; RLS must be enabled).
# NEVER put the service_role key in a VITE_* variable — it would ship to
# every browser and bypass RLS.
VITE_SUPABASE_ANON_KEY=
